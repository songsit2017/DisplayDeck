<Window x:Class="DisplayManagerClone.TitleBarOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TitleBarOverlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        ResizeMode="NoResize" ShowActivated="False" Focusable="False"
        Height="28" Width="132">
    <Window.Resources>
        <Style x:Key="SnapZoneButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Zone" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Zone" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Zone" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#E62D2D30" CornerRadius="4" BorderBrush="#FF0078D7" BorderThickness="1" Padding="2" Margin="1">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="BtnSnap" Content="▥" ToolTip="Snap to a zone on any monitor"
                    AutomationProperties.Name="Snap across monitors" Width="28" Height="22" Margin="1,0"
                    Background="#FF3E3E42" Foreground="White" BorderThickness="0" Click="BtnSnap_Click"/>
            <Button x:Name="BtnPrevMonitor" Content="◀" ToolTip="Move Window to Previous Monitor"
                    Width="28" Height="22" Margin="1,0" FontSize="11" FontWeight="Bold"
                    Background="#FF3E3E42" Foreground="White" BorderThickness="0"
                    Focusable="False" Click="BtnPrevMonitor_Click"/>
            <Button x:Name="BtnNextMonitor" Content="▶" ToolTip="Move Window to Next Monitor"
                    Width="28" Height="22" Margin="1,0" FontSize="11" FontWeight="Bold"
                    Background="#FF3E3E42" Foreground="White" BorderThickness="0"
                    Focusable="False" Click="BtnNextMonitor_Click"/>
            <Button x:Name="BtnPinTop" Content="📌" ToolTip="Toggle Window Always On Top"
                    Width="28" Height="22" Margin="1,0" FontSize="11"
                    Background="#FF3E3E42" Foreground="White" BorderThickness="0"
                    Focusable="False" Click="BtnPinTop_Click"/>
        </StackPanel>
    </Border>
</Window>
