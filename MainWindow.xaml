<Window x:Class="DisplayManagerClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="Display Manager Clone" MinHeight="600" MinWidth="800" Height="650" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="Display Manager Clone">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Settings" Click="Settings_Click" />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        
        <TabControl Margin="10">
            <TabItem Header="Functions (Hotkeys)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Assign custom hotkeys to window management functions. Click 'Assign' to set." Margin="0,0,0,10" Foreground="Gray"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Set Hotkey:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtHotkeyInput" Width="200" IsReadOnly="True" PreviewKeyDown="TxtHotkeyInput_PreviewKeyDown" Margin="0,0,10,0" Padding="2" Text="Click here and press a key combo..."/>
                        <Button Content="Assign to Selected" Padding="15,2" Click="BtnAssignHotkey_Click" Margin="0,0,10,0" Background="#FF0078D7" Foreground="White"/>
                        <Button Content="Clear Selected" Padding="15,2" Click="BtnClearHotkey_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="GridHotkeys" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Function" Binding="{Binding ActionName}" Width="*"/>
                            <DataGridTextColumn Header="Hotkey" Binding="{Binding DisplayHotkey}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Window Rules">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Automatically move specific applications to a designated monitor when they are opened." TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Process Name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TxtRuleProcess" Width="130" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <Button Content="Browse..." Padding="5,2" Click="BrowseRuleExe_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Target Monitor:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbRuleMonitors" DisplayMemberPath="DisplayName" Width="180" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <Button Content="Add Rule" Padding="15,5" Click="AddRule_Click" Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="LstRules" Grid.Row="0" Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Width="150"/>
                                        <TextBlock Text=" ➔ " Foreground="Gray"/>
                                        <TextBlock Text="{Binding TargetMonitorDisplayName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="1" Content="Remove Selected Rule" Padding="10,5" Click="RemoveRule_Click" HorizontalAlignment="Left" Foreground="#FFD32F2F" />
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Wallpapers">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <CheckBox x:Name="ChkManageWallpaper" Grid.Row="0" Content="Allow DisplayManager to manage the Desktop Wallpaper" Margin="5" IsChecked="True" FontWeight="Bold" Checked="ChkManageWallpaper_CheckedChanged" Unchecked="ChkManageWallpaper_CheckedChanged"/>
                    
                    <!-- Monitor Preview Canvas -->
                    <Border Grid.Row="1" Background="#FF222222" Margin="5,10,5,10" BorderBrush="#FF444444" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <TextBlock Text="Select a monitor below or click here" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="0"/>
                            <Canvas x:Name="WallpaperCanvas" ClipToBounds="True" Background="Transparent" 
                                    MouseLeftButtonDown="WallpaperCanvas_MouseLeftButtonDown" MouseMove="WallpaperCanvas_MouseMove" MouseLeftButtonUp="WallpaperCanvas_MouseLeftButtonUp" MouseWheel="WallpaperCanvas_MouseWheel" Panel.ZIndex="1" SizeChanged="WallpaperCanvas_SizeChanged"/>
                        </Grid>
                    </Border>
                    
                    <TextBlock Grid.Row="1" Text="Tip: In Span mode, drag monitors to align them, and use Mouse Wheel to resize them to match their physical sizes!" Foreground="White" Background="#80000000" Padding="5" FontStyle="Italic" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" Panel.ZIndex="2"/>


                    <Border Grid.Row="2" Background="#FFF0F0F0" Padding="15" CornerRadius="5" Margin="5,0,5,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                                <TextBlock Text="Background Mode" FontWeight="Bold" Margin="0,0,0,10"/>
                                <RadioButton x:Name="RbSpan" Content="Span across all monitors" Margin="0,2" Checked="BackgroundMode_Checked"/>
                                <StackPanel x:Name="PanelBezelComp" Orientation="Horizontal" Margin="20,0,0,5" IsEnabled="{Binding IsChecked, ElementName=RbSpan}">
                                    <TextBlock Text="Bezel Gap (px): X " VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBezelX" Text="0" Width="40" Margin="0,0,10,0" TextChanged="TxtBezel_TextChanged"/>
                                    <TextBlock Text="Y " VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBezelY" Text="0" Width="40" TextChanged="TxtBezel_TextChanged"/>
                                </StackPanel>
                                <RadioButton x:Name="RbDifferentImage" Content="Different image for each monitor" IsChecked="True" Margin="0,2" Checked="BackgroundMode_Checked"/>
                                <RadioButton x:Name="RbSameImage" Content="Same image on each monitor" Margin="0,2" Checked="BackgroundMode_Checked"/>
                                <RadioButton x:Name="RbSlideshow" Content="Slideshow from folder" Margin="0,2" Checked="BackgroundMode_Checked"/>
                                <StackPanel x:Name="PanelSlideshow" Margin="20,0,0,5" IsEnabled="{Binding IsChecked, ElementName=RbSlideshow}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Button Content="Choose Folder..." Padding="5,2" Click="ChooseSlideshowFolder_Click" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TxtSlideshowFolder" Text="(No folder chosen)" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" Foreground="Gray"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Change Every:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <ComboBox x:Name="CmbSlideshowInterval" Width="80">
                                            <ComboBoxItem Content="1 min" Tag="60" />
                                            <ComboBoxItem Content="5 min" Tag="300" />
                                            <ComboBoxItem Content="15 min" Tag="900" />
                                            <ComboBoxItem Content="30 min" Tag="1800" IsSelected="True" />
                                            <ComboBoxItem Content="1 hour" Tag="3600" />
                                            <ComboBoxItem Content="1 day" Tag="86400" />
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSlideshowShuffle" Content="Shuffle Images" Margin="0,2" IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock Text="Wallpaper Source" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TxtWallpaperSource" Grid.Column="1" Text="Solid Color" VerticalAlignment="Center" IsReadOnly="True" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="Browse Image..." Width="100" Padding="5" Margin="0,0,5,0" Click="ChangeWallpaperSource_Click"/>
                                    <Button Grid.Column="3" Content="Pick Color..." Width="100" Padding="5" Click="PickColor_Click"/>
                                </Grid>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="20,0,0,0">
                                <Button Content="Apply Wallpaper" Padding="20,10" Click="ApplyWallpaper_Click" FontWeight="Bold" Background="#FF0078D7" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <TabItem Header="Monitor Control Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Top Bar: Profiles and Identify -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbProfiles" Width="120" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Button Content="Load" Padding="10,2" Click="RestoreLayout_Click" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Button Content="Delete" Padding="10,2" Click="DeleteProfile_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtProfileName" Width="100" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="Enter new profile name" />
                            <Button Content="Save New" Padding="10,2" Click="SaveLayout_Click" Margin="0,0,15,0" VerticalAlignment="Center" Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>
                            <CheckBox x:Name="ChkAutoRecovery" Content="Watchdog Auto-Recovery" VerticalAlignment="Center" Margin="0,0,15,0" Checked="ChkAutoRecovery_CheckedChanged" Unchecked="ChkAutoRecovery_CheckedChanged" ToolTip="Automatically restore last active profile on display change" />
                            <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows" VerticalAlignment="Center" Checked="ChkStartWithWindows_CheckedChanged" Unchecked="ChkStartWithWindows_CheckedChanged" ToolTip="Launch this application automatically when Windows starts" />
                        </StackPanel>
                        
                        <Button Grid.Column="2" Content="Identify" Padding="20,5" Click="Identify_Click" FontWeight="Bold" Background="#FF333333" Foreground="White" />
                    </Grid>
                    
                    <!-- Visual Monitor Canvas -->
                    <Border Grid.Row="1" BorderBrush="#FF444444" BorderThickness="1" Background="#FF222222" Margin="0,0,0,15">
                        <Canvas x:Name="MonitorCanvas" ClipToBounds="True" Background="Transparent" 
                                MouseLeftButtonDown="MonitorCanvas_MouseLeftButtonDown"
                                MouseMove="MonitorCanvas_MouseMove"
                                MouseLeftButtonUp="MonitorCanvas_MouseLeftButtonUp" />
                    </Border>
                    
                    <!-- Bottom Control Panel -->
                    <Border Grid.Row="2" Background="#FFF0F0F0" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,10">
                                <TextBlock Text="Select Monitor:" Margin="0,0,0,5" FontWeight="Bold" />
                                <ComboBox x:Name="CmbConfigMonitors" DisplayMemberPath="DisplayName" SelectionChanged="CmbConfigMonitors_SelectionChanged" Width="250" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,10">
                                <TextBlock Text="Resolution:" Margin="0,0,0,5" FontWeight="Bold" />
                                <ComboBox x:Name="CmbResolutions" SelectionChanged="CmbResolutions_SelectionChanged" Width="200" Margin="0,0,0,5" />
                                <TextBlock Text="Orientation:" Margin="0,5,0,5" FontWeight="Bold" />
                                <ComboBox x:Name="CmbOrientation" SelectionChanged="CmbOrientation_SelectionChanged" Width="200">
                                    <ComboBoxItem Content="Landscape (0°)" Tag="0" />
                                    <ComboBoxItem Content="Portrait (90°)" Tag="1" />
                                    <ComboBoxItem Content="Landscape flipped (180°)" Tag="2" />
                                    <ComboBoxItem Content="Portrait flipped (270°)" Tag="3" />
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Button Content="Apply Settings" Padding="20,10" Click="ApplyConfig_Click" FontWeight="Bold" Background="#FF0078D7" Foreground="White" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <CheckBox x:Name="ChkPrimary" Content="Make this my main display" VerticalAlignment="Center" Margin="0,0,20,0" Checked="ChkPrimary_Checked" Unchecked="ChkPrimary_Checked" />
                                <TextBlock Text="Position (X, Y): " VerticalAlignment="Center" />
                                <TextBox x:Name="TxtPosX" Width="50" Margin="0,0,5,0" TextChanged="TxtPos_TextChanged" />
                                <TextBox x:Name="TxtPosY" Width="50" TextChanged="TxtPos_TextChanged" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
