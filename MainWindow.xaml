<Window x:Class="DisplayManagerClone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="Display Manager Clone" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="Display Manager Clone">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Settings" Click="Settings_Click" />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        
        <TabControl Margin="10">
            <TabItem Header="Window Manager">
                <StackPanel Margin="20">
                    <TextBlock Text="Window Manager Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Hotkey to move active window to next monitor:" />
                    <TextBlock Text="Ctrl + Win + X" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="Close this window to minimize to system tray." Margin="0,40,0,0" FontStyle="Italic" Foreground="Gray"/>
                </StackPanel>
            </TabItem>
            
            <TabItem Header="Wallpapers">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <CheckBox Grid.Row="0" Content="Allow DisplayManager to manage the Desktop Wallpaper" Margin="5" IsChecked="True" />
                    
                    <GroupBox Grid.Row="1" Header="Wallpaper Profile" Margin="5">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Margin="0,0,5,0" SelectedIndex="0">
                                <ComboBoxItem Content="Default Profile"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="New Profile" Width="80" Margin="5,0"/>
                            <Button Grid.Column="2" Content="Rename" Width="70" Margin="5,0"/>
                            <Button Grid.Column="3" Content="Save As" Width="70" Margin="5,0"/>
                            <Button Grid.Column="4" Content="Delete" Width="70" Margin="5,0"/>
                            <Button Grid.Column="5" Content="Use Default Options" Width="120" Margin="5,0"/>
                        </Grid>
                    </GroupBox>
                    
                    <Border Grid.Row="2" Background="Black" Margin="5" BorderBrush="Gray" BorderThickness="1">
                        <!-- Monitor Preview Canvas -->
                        <Canvas x:Name="WallpaperCanvas" ClipToBounds="True" Background="Transparent" 
                                MouseLeftButtonDown="WallpaperCanvas_MouseLeftButtonDown"/>
                    </Border>
                    
                    <Grid Grid.Row="3" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="Background Mode" Margin="0,0,5,5">
                                <StackPanel Margin="5">
                                    <RadioButton x:Name="RbSpan" Content="Span an image across all monitors" Margin="0,2"/>
                                    <RadioButton x:Name="RbDifferentImage" Content="Use a different image for each monitor" IsChecked="True" Margin="0,2"/>
                                    <RadioButton x:Name="RbSameImage" Content="Use the same image on each monitor" Margin="0,2"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Wallpaper Source" Margin="0,5,5,0">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtWallpaperSource" Grid.Column="1" Text="Solid Color" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Content="Change" Width="70" Click="ChangeWallpaperSource_Click"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                        
                        <GroupBox Grid.Column="1" Header="Monitor Settings" Margin="5,0,0,0">
                            <TabControl Margin="5">
                                <TabItem Header="Color">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Color Mode:" Margin="0,0,0,5"/>
                                            <RadioButton Content="Normal" IsChecked="True" Margin="0,2"/>
                                            <RadioButton Content="Grayscale" Margin="0,2"/>
                                            <RadioButton Content="Sepia Tone" Margin="0,2"/>
                                            <RadioButton Content="Inverted" Margin="0,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Background Color:" Margin="0,0,0,5"/>
                                            <Button Width="80" Height="25" Background="Black" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                            <CheckBox Content="Use Background Gradient" Margin="0,0,0,5"/>
                                            <Button Width="80" Height="25" Background="Black" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                            <TextBlock Text="Gradient Angle (degrees):"/>
                                            <TextBox Text="0" Width="40" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Adjustments">
                                    <TextBlock Text="Adjustments content goes here" Margin="10"/>
                                </TabItem>
                                <TabItem Header="Info">
                                    <TextBlock Text="Info content goes here" Margin="10"/>
                                </TabItem>
                            </TabControl>
                        </GroupBox>
                    </Grid>
                    
                    <Grid Grid.Row="4" Margin="5,15,5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Wallpaper Settings" Width="120" Padding="5"/>
                        <Button Grid.Column="2" Content="OK" Width="80" Padding="5" Margin="5,0"/>
                        <Button Grid.Column="3" Content="Cancel" Width="80" Padding="5" Margin="5,0"/>
                        <Button Grid.Column="4" Content="Apply" Width="80" Padding="5" Margin="5,0" Click="ApplyWallpaper_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Monitor Control Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Top Bar: Profiles and Identify -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Button Content="Save Layout" Padding="15,5" Click="SaveLayout_Click" FontWeight="Bold" Margin="0,0,10,0"/>
                            <Button Content="Restore Layout" Padding="15,5" Click="RestoreLayout_Click" FontWeight="Bold" Margin="0,0,15,0"/>
                            <CheckBox x:Name="ChkAutoRecovery" Content="Watchdog Auto-Recovery" VerticalAlignment="Center" Checked="ChkAutoRecovery_CheckedChanged" Unchecked="ChkAutoRecovery_CheckedChanged" />
                        </StackPanel>
                        
                        <Button Grid.Column="2" Content="Identify" Padding="20,5" Click="Identify_Click" FontWeight="Bold" Background="#FF333333" Foreground="White" />
                    </Grid>
                    
                    <!-- Visual Monitor Canvas -->
                    <Border Grid.Row="1" BorderBrush="#FF444444" BorderThickness="1" Background="#FF222222" Margin="0,0,0,15">
                        <Canvas x:Name="MonitorCanvas" ClipToBounds="True" Background="Transparent" 
                                MouseLeftButtonDown="MonitorCanvas_MouseLeftButtonDown"
                                MouseMove="MonitorCanvas_MouseMove"
                                MouseLeftButtonUp="MonitorCanvas_MouseLeftButtonUp" />
                    </Border>
                    
                    <!-- Bottom Control Panel -->
                    <Border Grid.Row="2" Background="#FFF0F0F0" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,10">
                                <TextBlock Text="Select Monitor:" Margin="0,0,0,5" FontWeight="Bold" />
                                <ComboBox x:Name="CmbConfigMonitors" DisplayMemberPath="DisplayName" SelectionChanged="CmbConfigMonitors_SelectionChanged" Width="250" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,10">
                                <TextBlock Text="Resolution:" Margin="0,0,0,5" FontWeight="Bold" />
                                <ComboBox x:Name="CmbResolutions" SelectionChanged="CmbResolutions_SelectionChanged" Width="200" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Button Content="Apply Settings" Padding="20,10" Click="ApplyConfig_Click" FontWeight="Bold" Background="#FF0078D7" Foreground="White" />
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <CheckBox x:Name="ChkPrimary" Content="Make this my main display" VerticalAlignment="Center" Margin="0,0,20,0" Checked="ChkPrimary_Checked" Unchecked="ChkPrimary_Checked" />
                                <TextBlock Text="Position (X, Y): " VerticalAlignment="Center" />
                                <TextBox x:Name="TxtPosX" Width="50" Margin="0,0,5,0" TextChanged="TxtPos_TextChanged" />
                                <TextBox x:Name="TxtPosY" Width="50" TextChanged="TxtPos_TextChanged" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
