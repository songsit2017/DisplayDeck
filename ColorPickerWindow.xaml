<Window x:Class="DisplayManagerClone.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Color" Height="250" Width="300" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Enter Hex Color (e.g., #FF0000 for Red):" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtHex" Grid.Row="1" VerticalAlignment="Top" Text="#000000" FontSize="16" TextChanged="TxtHex_TextChanged"/>
        <Border x:Name="ColorPreview" Grid.Row="1" Height="80" Margin="0,40,0,0" Background="Black" BorderBrush="Gray" BorderThickness="1"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="0,0,10,0" Click="OK_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
